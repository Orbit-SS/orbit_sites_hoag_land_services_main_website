# ---------------------------------------------------------------------------
# Hoag Land Services · environment variables
#
# Copy to `.env.local` for local development, or set as Vercel Environment
# Variables (Production + Preview) on the `hoag-site` project.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Form delivery (Resend) — REQUIRED for /api/contact and /api/join.
# Without RESEND_API_KEY the routes return 503 rather than silently dropping
# a lead. Replaces the previous Brevo setup.
# ---------------------------------------------------------------------------

# Shared Service Storm Resend account key.
RESEND_API_KEY=re_REPLACE_ME

# "From:" address on outgoing lead notifications. The domain MUST be verified
# in Resend or the send is rejected. House convention is a `send.` subdomain,
# which keeps DKIM/SPF off the root and leaves the client's Zoho MX untouched.
#   Target:   "Hoag Land Services <leads@send.hlsdeland.com>"
#   Fallback: unset falls back to Resend's sandbox sender, which can only
#             deliver to addresses verified on the Resend account.
FORM_FROM_EMAIL="Hoag Land Services <leads@send.hlsdeland.com>"

# Where leads land. Comma-separated for multiple recipients.
FORM_NOTIFY_EMAIL=tyler@hlsdeland.com

# Test escape hatch. While set, EVERY submission routes here instead of Tyler.
# Set it before exercising the forms locally or on a preview deploy — the old
# Brevo setup had no such guard and test submissions hit the live client.
# Delete it to restore normal delivery.
# FORM_NOTIFY_OVERRIDE=oscar@servicestorm.io

# ---------------------------------------------------------------------------
# Maps
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.REPLACE_ME
